# =============================================================================
# Zorro AI Trading Assistant — environment
# Single operator. Never commit real secrets.
#
# .env is BOOTSTRAP ONLY (first install). After first launch the operator
# configures trading keys in Settings → Providers. Settings overlay overrides
# .env for the same key. Empty Settings value falls back to .env.
# Host concerns below (database, redis, encryption, bind) stay env-only.
# =============================================================================

# --- App (host / bootstrap — not shown in the browser) ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ENCRYPTION_KEY=change-me-fernet-or-32-byte-hex
# Optional alias for the same master key (Settings overlay encryption)
SETTINGS_SECRET=
OPERATOR_PIN=
CONFIRMATION_PIN=
DEFAULT_LANGUAGE=en
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_ANALYSIS_PER_MINUTE=6
BOT_MIN_ORDER_INTERVAL_SECONDS=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://zorro:zorro@localhost:5432/zorro
REDIS_URL=redis://localhost:6379/0

# --- Anthropic (Claude Agent SDK) — also editable in Settings → Models ---
ANTHROPIC_API_KEY=
QUICK_MODEL=claude-sonnet-5
DEEP_MODEL=claude-fable-5

# --- OANDA (SOLE market-data source) — also Settings → Market data ---
# Overlay key name is OANDA_API_TOKEN (falls back to OANDA_API_KEY here).
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# --- Twelve Data (failover / cross-check ONLY — never compute indicators) ---
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
PRICE_DIVERGENCE_BPS=15

# --- Finnhub (news ranked by impact) ---
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# --- MetaApi (execution + live account status ONLY) ---
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=new-york

# --- Telegram (same brain as web; includes /stopall kill switch) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Optional demo operator bootstrap ---
OPERATOR_EMAIL=operator@local
OPERATOR_PASSWORD=change-me
